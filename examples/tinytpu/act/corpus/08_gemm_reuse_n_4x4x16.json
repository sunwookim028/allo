{
  "name": "gemm_reuse_n_4x4x16",
  "stresses": "reuse in N: four activation rows against four weight tiles, so the activations should stay resident and the weights should stream",
  "einsum": "mk,kn->mn",
  "dims": {
    "m": 4,
    "k": 4,
    "n": 16
  },
  "inputs": [
    {
      "name": "X",
      "subscript": "mk",
      "dtype": "int8",
      "buffer": "A",
      "origin": [
        0,
        0
      ]
    },
    {
      "name": "W",
      "subscript": "kn",
      "dtype": "int8",
      "buffer": "B",
      "origin": [
        0,
        0
      ]
    }
  ],
  "constants": [],
  "output": {
    "name": "Y",
    "subscript": "mn",
    "dtype": "int8",
    "buffer": "C",
    "origin": [
      0,
      0
    ],
    "write_window": "exact"
  },
  "accumulator": "int32",
  "epilogue": [
    "saturate"
  ],
  "operand_pad": "arbitrary",
  "known_gap": null
}
