      "origin": [
        0,
        0
      ]
    },
    {
      "name": "W",
      "subscript": "bkn",
      "dtype": "int8",
      "buffer": "B",
      "origin": [
        0,
        0
      ]
    }
  ],
  "constants": [],
  "output": {
    "name": "Y",
    "subscript": "bmn",
    "dtype": "int8",
    "buffer": "C",
    "origin": [
      0,
      0
    ],
    "write_window": "exact"
  },
  "accumulator": "int32",
  "epilogue": [
    "saturate"
  ],
  "operand_pad": "arbitrary",
  "known_gap": null
}
