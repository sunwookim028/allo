{
  "name": "gemm_12x12x12",
  "stresses": "three tiles in every dimension: an odd tile count, so any mapper that assumes a power-of-two trip count breaks here",
  "einsum": "mk,kn->mn",
  "dims": {
    "m": 12,
    "k": 12,
    "n": 12
  },
  "inputs": [
    {
      "name": "X",
      "subscript": "mk",
      "dtype": "int8",
      "buffer": "A",
      "origin": [
        0,
        0
      ]
    },
    {
      "name": "W",
      "subscript": "kn",
      "dtype": "int8",
      "buffer": "B",
      "origin": [
        0,
        0
      ]
    }
  ],
  "constants": [],
  "output": {
    "name": "Y",
    "subscript": "mn",
    "dtype": "int8",
    "buffer": "C",
    "origin": [
      0,
      0
    ],
    "write_window": "exact"
  },
  "accumulator": "int32",
  "epilogue": [
    "saturate"
  ],
  "operand_pad": "arbitrary",
  "known_gap": null
}
