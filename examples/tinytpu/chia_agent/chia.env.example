# Copy to `chia.env` at the repository root (it is gitignored) and fill in.
# Never commit the filled-in file. Then check it, $0:
#   examples/tinytpu/chia_agent/gcp_setup.sh

# --- Google Cloud / Vertex AI ---------------------------------------------
# CHIA's own project, on the CHIA2026 billing account. Everything is PER
# PROCESS: this file is sourced into the shell that runs CHIA. Do NOT run
# `gcloud config set project` or `gcloud auth application-default
# set-quota-project` for CHIA -- other work on this host uses the global
# config and the ADC quota project (test-adrs), and CHIA must not bill it.
# Needs ADC (`gcloud auth application-default login`, once; see gcp_setup.sh).
export GOOGLE_CLOUD_PROJECT=chia2026-tinytpu
export TINYTPU_VERTEX_LOCATION=global
export TINYTPU_OPENCODE_MODEL=google-vertex/gemini-3.1-pro-preview

# --- Billing ------------------------------------------------------------------
# preflight.py refuses to start unless GOOGLE_CLOUD_PROJECT bills this account.
export CHIA_BILLING_ACCOUNT=01BF39-94AA3F-36BACB   # CHIA2026
# Cumulative cap over every CHIA run on CHIA2026 (opencode's figures, since
# the cutover in chia_agent/billing.json). A run's --budget-usd must fit in
# what is left. Raise it here; no code change needed.
export CHIA_TOTAL_CAP_USD=500
# opencode's google-vertex provider resolves the project as
#   options.project (loop.py sets it from GOOGLE_CLOUD_PROJECT)
#   ?? GOOGLE_VERTEX_PROJECT ?? GOOGLE_CLOUD_PROJECT ?? GCP_PROJECT ?? GCLOUD_PROJECT
# and the location as options.location ?? GOOGLE_VERTEX_LOCATION
#   ?? GOOGLE_CLOUD_LOCATION ?? VERTEX_LOCATION ?? "us-central1".
# Set both to the same values so no path falls through to another project.
export GOOGLE_VERTEX_PROJECT=$GOOGLE_CLOUD_PROJECT
export GOOGLE_VERTEX_LOCATION=$TINYTPU_VERTEX_LOCATION
# google-auth-library uses this instead of the ADC file's quota_project_id.
# opencode's Vertex fetch sends only Authorization (no x-goog-user-project), so
# a model call is billed to the project in its URL regardless; this keeps any
# client that does send a quota project on CHIA's project too.
export GOOGLE_CLOUD_QUOTA_PROJECT=$GOOGLE_CLOUD_PROJECT

# --- Toolchain ---------------------------------------------------------------
# The `allo` env's interpreter (py3.12). Called directly, not via `conda run`.
export TINYTPU_ALLO_PYTHON=$HOME/miniconda3/envs/allo/bin/python
# The LLVM this checkout's mlir/build was built against. The allo env does NOT
# set it; the simulator asserts without it.
export LLVM_BUILD_DIR=/home/sk3463/llvm-allo-6b09f739/build
export OMP_NUM_THREADS=8

export ALLO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# opencode, installed in-tree by
#   npm ci --prefix examples/tinytpu/chia_agent
export OPENCODE_BIN="$ALLO_ROOT/examples/tinytpu/chia_agent/node_modules/.bin"
export PATH="$OPENCODE_BIN:$PATH"
