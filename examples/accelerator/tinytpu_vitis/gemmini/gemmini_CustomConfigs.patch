diff --git a/src/main/scala/gemmini/CustomConfigs.scala b/src/main/scala/gemmini/CustomConfigs.scala
index 011d7ce..bede0ed 100644
--- a/src/main/scala/gemmini/CustomConfigs.scala
+++ b/src/main/scala/gemmini/CustomConfigs.scala
@@ -49,6 +49,41 @@ object GemminiCustomConfigs {
     acc_capacity = CapacityInKilobytes(128),
   )
 
+
+  // int8 / int32 on a 4x4 mesh: Gemmini's *default* data type, at the array
+  // size the Allo TinyTPU generates (T = 4). The stock GemminiRocketConfig is
+  // int8 at 16x16 and FPGemminiRocketConfig is fp32 at 4x4, so neither is a
+  // matched baseline -- one differs in mesh size, the other in data type.
+  // This one differs in neither, which is what makes a cycle comparison mean
+  // something. Everything else is left at defaultConfig, including
+  // dataflow = BOTH (allo_cmp.c passes WS to tiled_matmul_auto).
+  val int8Dim4Config = defaultConfig.copy(
+    meshRows = 4,
+    meshColumns = 4,
+    tileRows = 1,
+    tileColumns = 1,
+    has_training_convs = false,
+  )
+
+  // int8 / int32 on an 8x8 mesh: the SECOND matched point. TinyTPU-isa's
+  // array size T is a build parameter (T=8 verifies bit-exact at MAXDIM=64),
+  // so a matched-array comparison can be made at two sizes instead of one --
+  // which is what separates "our design is slower" from "our design is slower
+  // at this one size". The delta from Gemmini's own defaultConfig is the same
+  // two fields as int8Dim4Config: the mesh, and has_training_convs (conv
+  // hardware neither benchmark touches, absent from the generated header).
+  // Nothing else is touched -- in particular spad_read_delay (4),
+  // tile_latency (0), mesh_output_delay (1), dataflow (BOTH) and the
+  // capacities stay at Gemmini's defaults, because tuning any of them is
+  // tuning the opponent.
+  val int8Dim8Config = defaultConfig.copy(
+    meshRows = 8,
+    meshColumns = 8,
+    tileRows = 1,
+    tileColumns = 1,
+    has_training_convs = false,
+  )
+
   // Specify which of your custom configs you want to build here
   val customConfig = baselineInferenceConfig
 }
