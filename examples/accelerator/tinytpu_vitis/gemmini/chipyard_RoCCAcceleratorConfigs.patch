+// int8/int32 Gemmini at DIM=4 -- the data-type- and mesh-matched baseline for
+// the Allo TinyTPU comparison (see gemmini.GemminiCustomConfigs.int8Dim4Config).
+class Int8Dim4GemminiRocketConfig extends Config(
+  new gemmini.GemminiCustomConfig(gemmini.GemminiCustomConfigs.int8Dim4Config) ++
+  new freechips.rocketchip.rocket.WithNHugeCores(1) ++
+  new chipyard.config.WithSystemBusWidth(128) ++
+  new chipyard.config.AbstractConfig)
+
+// int8/int32 Gemmini at DIM=8 -- the second array-size-matched baseline, for
+// TinyTPU-isa built at T=8 (see gemmini.GemminiCustomConfigs.int8Dim8Config).
+class Int8Dim8GemminiRocketConfig extends Config(
+  new gemmini.GemminiCustomConfig(gemmini.GemminiCustomConfigs.int8Dim8Config) ++
+  new freechips.rocketchip.rocket.WithNHugeCores(1) ++
+  new chipyard.config.WithSystemBusWidth(128) ++
+  new chipyard.config.AbstractConfig)
+
+// The same two points with local memory capacity matched to TinyTPU-isa
+// (8 KiB scratchpad, 4 KiB accumulator). These exist only to be elaborated to
+// Verilog for the standard-cell AREA comparison, where both sides synthesise
+// memories as flip-flops; the cycle numbers are measured on the configs above,
+// and the capacity sweep in designs/gemmini_comparison.rst is what says the
+// two agree cycle-for-cycle at every published shape.
+class Int8Dim4AreaGemminiRocketConfig extends Config(
+  new gemmini.GemminiCustomConfig(gemmini.GemminiCustomConfigs.int8Dim4AreaConfig) ++
+  new freechips.rocketchip.rocket.WithNHugeCores(1) ++
+  new chipyard.config.WithSystemBusWidth(128) ++
+  new chipyard.config.AbstractConfig)
+
+class Int8Dim8AreaGemminiRocketConfig extends Config(
+  new gemmini.GemminiCustomConfig(gemmini.GemminiCustomConfigs.int8Dim8AreaConfig) ++
+  new freechips.rocketchip.rocket.WithNHugeCores(1) ++
+  new chipyard.config.WithSystemBusWidth(128) ++
+  new chipyard.config.AbstractConfig)
+
