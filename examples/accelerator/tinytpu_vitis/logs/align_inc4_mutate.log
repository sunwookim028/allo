  pe_shadow_not_swapped     weight double buffer: the PE keeps its first nonzero weight instead of taking the next mm's from wq
  vru_flag_sticky           the weight-switch flag is never cleared, so every pushed row switches weights
  vmu_vld_off_by_one        vld reads vmem one row late
  vpu_read_off_by_one       vmatload/vmatpush/vst read vreg rows one late
  vpu_vld_dst_ignored       vld writes vreg[r], ignoring its destination base f0
  vpu_vld_zero_extends      vld zero-extends int8 lanes instead of sign-extending
  vpu_narrow_high_byte      the array gets bits 8..15 of each lane, not the low 8
  dma_ld_src_swapped        dma_ld reads B for src A and A for src B
  dma_ld_row_ignored        dma_ld (A path) ignores its DRAM row f1
  vmemst_row_ignored        dma_st ignores the DRAM row f1
  dma_st_accumulates_C      dma_st adds into C (relies on C arriving zeroed)
  prefetch_lane7_dup        the 8-wide program prefetch copies word 6 into word 7 of every group
