 KB_MAX = MAXDIM // T           # column blocks in the widest matrix
 assert MAXDIM % T == 0, "a DRAM row must be a whole number of packed words"
 WPR = MAXDIM // T              # packed words per DRAM row
+#: Operand-burst width. `align_value(64)` lets Vitis widen the operand ports, so
+#: `dma_ld`'s burst loops move DMA_ROWS whole DRAM rows per iteration -- up to
+#: one 64-byte beat -- instead of one packed word. DMA_ROWS divides MAXDIM, so
+#: rounding a matrix's row span up to a multiple of it never leaves the
+#: MAXDIM x MAXDIM operand; the extra rows land in `rbA`/`rbB` rows no
+#: instruction of that program names. (First found by the CHIA run of
+#: 2026-09-19, as a literal 4-row unroll; -59 cycles at 16x16x16.)
+BUS_BYTES = 64
+DMA_ROWS = max(r for r in range(1, MAXDIM + 1)
+               if MAXDIM % r == 0 and r * MAXDIM <= max(BUS_BYTES, MAXDIM))
+DMA_WORDS = DMA_ROWS * WPR     # packed words per burst iteration
 A_VR = 0                       # A vregs:  kb * MAXDIM + m  (dma_ld'd direct)
 B_SP = 0                       # B words:  nb * MAXDIM + k  (mm's weights)
