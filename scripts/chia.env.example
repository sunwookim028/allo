# Copy to `chia.env` at the repo root and fill in. Every script here sources it,
# so this file is the single place environment lives.

# --- Google Cloud ----------------------------------------------------------
# The project that serves Vertex AI. Needs aiplatform.googleapis.com enabled,
# billing linked, and Application Default Credentials present:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project $GOOGLE_CLOUD_PROJECT
export GOOGLE_CLOUD_PROJECT=your-project-id
export TINYTPU_VERTEX_LOCATION=global
export TINYTPU_OPENCODE_MODEL=google-vertex/gemini-3.1-pro-preview

# --- Toolchain -------------------------------------------------------------
export TINYTPU_VITIS_SETTINGS=/opt/xilinx/Vitis_HLS/2023.2/settings64.sh
export TINYTPU_CONDA="$(command -v conda)"
export ALLO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export OPENCODE_BIN=$HOME/chia-tools/opencode-cli/node_modules/.bin

# --- Derived (usually leave as-is) -----------------------------------------
export PYTHONPATH="$ALLO_ROOT"
export SKBUILD_EDITABLE_SKIP="$ALLO_ROOT/build"
export OMP_NUM_THREADS=8
export PATH="$OPENCODE_BIN:$HOME/.local/allo-bin:$PATH"
