diff --git a/mlir/lib/Translation/EmitVivadoHLS.cpp b/mlir/lib/Translation/EmitVivadoHLS.cpp
index 20d4c6aa..b760bcc3 100644
--- a/mlir/lib/Translation/EmitVivadoHLS.cpp
+++ b/mlir/lib/Translation/EmitVivadoHLS.cpp
@@ -2600,6 +2600,42 @@ void allo::hls::VhlsModuleEmitter::emitLoopDirectives(Operation *op) {
     addIndent();
   }
 
+  if (auto binds = llvm::dyn_cast_or_null<ArrayAttr>(
+          getLoopDirective(op, "bind_storage"))) {
+    auto func = op->getParentOfType<func::FuncOp>();
+    for (auto entry : binds) {
+      auto bind = llvm::dyn_cast<DictionaryAttr>(entry);
+      if (!bind || !func) {
+        emitError(op, "malformed `bind_storage` loop attribute");
+        continue;
+      }
+      Value var;
+      if (auto idx = bind.getAs<IntegerAttr>("arg_index")) {
+        if (idx.getInt() < (int64_t)func.getNumArguments())
+          var = func.getArgument(idx.getInt());
+      } else if (auto name = bind.getAs<StringAttr>("variable")) {
+        func.walk([&](memref::AllocOp alloc) {
+          auto n = alloc->getAttrOfType<StringAttr>("name");
+          if (!var && n && n.getValue() == name.getValue())
+            var = alloc.getResult();
+        });
+      }
+      if (!var || !isDeclared(var)) {
+        emitError(op, "bind_storage: the named array is not declared before "
+                      "this loop");
+        continue;
+      }
+      reduceIndent();
+      indent();
+      os << "#pragma HLS bind_storage variable=" << getName(var);
+      if (auto type = bind.getAs<StringAttr>("type"))
+        os << " type=" << type.getValue().str();
+      if (auto impl = bind.getAs<StringAttr>("impl"))
+        os << " impl=" << impl.getValue().str();
+      os << "\n";
+      addIndent();
+    }
+  }
   // `s.dependence(...)` (allo/customize.py): one dictionary per claim, each
   // naming the array either by its `name` attribute (a local buffer) or by
   // its position in the enclosing function's arguments.
